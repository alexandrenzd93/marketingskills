<div class="page-header container{% if section.settings.border %} page-header--border{% endif %}">
  {%- if section.settings.show_breadcrumb -%}
    <nav class="breadcrumb" aria-label="Fil d'Ariane">
      <a href="{{ routes.root_url }}">Accueil</a><span class="sep">/</span><span>{{ section.settings.title | default: page.title }}</span>
    </nav>
  {%- endif -%}
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h1 class="page-title page-title--xl">{{ section.settings.title | default: page.title }}</h1>
  {%- if section.settings.intro != blank -%}<div class="page-intro rte">{{ section.settings.intro }}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "En-tête de page",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Afficher le fil d'Ariane", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "La Collection" },
    { "type": "text", "id": "title", "label": "Titre (sinon le titre de la page)" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    { "type": "checkbox", "id": "border", "label": "Bordure inférieure", "default": false }
  ],
  "presets": [{ "name": "En-tête de page" }]
}
{% endschema %}
