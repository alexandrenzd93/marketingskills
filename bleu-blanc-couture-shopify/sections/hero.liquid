{%- liquid
  assign words = section.settings.title | strip | split: ' '
-%}
<section class="hero" id="hero-{{ section.id }}"{% if section.settings.bg_opacity %} style="--hero-bg-opacity: {{ section.settings.bg_opacity | divided_by: 100.0 }};"{% endif %}>
  {%- if section.settings.background_image != blank -%}
    {{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'hero__bg', widths: '800,1200,1600,2000,2400', sizes: '100vw', loading: 'eager', alt: '' }}
  {%- endif -%}
  <div class="grain" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__inner container">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}
      <h1 class="hero__title">
        {%- for w in words -%}<span class="word"><span>{{ w }}</span></span> {% endfor -%}
      </h1>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}<p class="hero__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
    <div class="hero__cta">
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--gold btn--lg" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="link-underline" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.coords != blank -%}<p class="hero__coords">{{ section.settings.coords }}</p>{%- endif -%}
  {%- if section.settings.season != blank -%}<p class="hero__season">{{ section.settings.season }}</p>{%- endif -%}

  {%- if section.settings.scroll_label != blank -%}
    <a class="hero__scroll" href="#{{ section.settings.scroll_anchor | default: 'manifeste' }}" aria-label="Défiler vers le bas">
      <span class="hero__scroll-label">{{ section.settings.scroll_label }}</span>
      <span class="hero__scroll-rail" aria-hidden="true"></span>
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Héros",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Collection Printemps — Été 2025" },
    { "type": "text", "id": "title", "label": "Titre (chaque mot est animé)", "default": "L'Élégance Made in France" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Une sélection intime de créatrices françaises. Des pièces pensées pour durer, façonnées dans les ateliers de Paris et d'Île-de-France." },
    { "type": "header", "content": "Boutons" },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Découvrir la sélection" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "link_label", "label": "Lien secondaire", "default": "Nos créateurs" },
    { "type": "url", "id": "link_url", "label": "URL du lien secondaire" },
    { "type": "header", "content": "Détails d'ambiance" },
    { "type": "text", "id": "coords", "label": "Coordonnées (bas gauche)", "default": "Paris · Made in France · Depuis 2024" },
    { "type": "text", "id": "season", "label": "Édition (bas droite)", "default": "Édition N°01" },
    { "type": "text", "id": "scroll_label", "label": "Libellé \"défiler\"", "default": "Défiler" },
    { "type": "text", "id": "scroll_anchor", "label": "Ancre de défilement", "default": "manifeste" },
    { "type": "header", "content": "Image de fond (optionnel)" },
    { "type": "image_picker", "id": "background_image", "label": "Image de fond" },
    { "type": "range", "id": "bg_opacity", "min": 10, "max": 100, "step": 5, "unit": "%", "label": "Opacité de l'image", "default": 55 }
  ],
  "presets": [{ "name": "Héros" }]
}
{% endschema %}
