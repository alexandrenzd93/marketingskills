<section class="inner-hero" style="align-items:center; min-height:{{ section.settings.min_height | default: 88 }}vh; {% if section.settings.bg_opacity %}--hero-bg-opacity:{{ section.settings.bg_opacity | divided_by: 100.0 }};{% endif %}">
  {%- if section.settings.background_image != blank -%}
    {{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'inner-hero__bg', widths: '800,1200,1600,2400', sizes: '100vw', loading: 'eager', alt: '' }}
  {%- endif -%}
  <div class="grain" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="inner-hero__inner container">
    <div class="dhero">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow inner-hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.name != blank -%}<h1 class="inner-hero__title dhero__name">{{ section.settings.name }}</h1>{%- endif -%}
        {%- if section.settings.subtitle != blank -%}<p class="inner-hero__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
      </div>
      <div class="dhero__portrait media {{ section.settings.tone | default: 'tone-portrait' }}">
        {%- render 'image-layers', image: section.settings.portrait, alt: section.settings.name, sizes: '(min-width:768px) 40vw, 80vw', loading: 'eager' -%}
      </div>
    </div>
  </div>
  {%- if section.settings.meta != blank -%}<p class="inner-hero__meta">{{ section.settings.meta }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "Héros créateur",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "My Tailor is Joh · Paris" },
    { "type": "text", "id": "name", "label": "Nom (le saut de ligne <br> est accepté)", "default": "Johanna<br>Richard" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Ex-costumière de l'Opéra de Paris. Elle taille aujourd'hui un vestiaire féminin dans les tissus deadstock de la Haute Couture — pièce par pièce, dans son atelier du Marais." },
    { "type": "text", "id": "meta", "label": "Méta (bas)", "default": "Le Marais · Tailleur féminin · Tissus deadstock" },
    { "type": "image_picker", "id": "portrait", "label": "Portrait" },
    { "type": "range", "id": "min_height", "min": 60, "max": 100, "step": 2, "unit": "vh", "label": "Hauteur", "default": 88 },
    {
      "type": "select", "id": "tone", "label": "Teinte de repli (portrait)",
      "options": [ { "value": "tone-portrait", "label": "Portrait" }, { "value": "tone-stone", "label": "Pierre" } ],
      "default": "tone-portrait"
    },
    { "type": "header", "content": "Image de fond (optionnel)" },
    { "type": "image_picker", "id": "background_image", "label": "Image de fond" },
    { "type": "range", "id": "bg_opacity", "min": 10, "max": 100, "step": 5, "unit": "%", "label": "Opacité", "default": 45 }
  ],
  "presets": [{ "name": "Héros créateur" }]
}
{% endschema %}
