<div class="page-header container">
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span class="sep">/</span><span>{{ section.settings.title | default: 'Collections' }}</span>
  </nav>
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h1 class="page-title page-title--xl">{{ section.settings.title | default: 'Nos Collections' }}</h1>
</div>

<section class="section" style="padding-top: clamp(20px,3vw,40px);">
  <div class="container">
    <div class="product-grid">
      {%- for collection in collections -%}
        <a class="product-card reveal" href="{{ collection.url }}">
          <div class="media {% cycle 'tone-grege','tone-ivoire','tone-sauge','tone-stone','tone-rose','tone-bleu' %}">
            {%- render 'image-layers', image: collection.featured_image, alt: collection.title -%}
            <span class="product-card__cta">Découvrir <span class="arrow">&rarr;</span></span>
          </div>
          <h3 class="product-card__name" style="margin-top:1rem;">{{ collection.title }}</h3>
          <div class="product-card__meta"><span class="product-card__collection">{{ collection.all_products_count }} pièces</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Liste des collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Les Maisons" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos Collections" }
  ]
}
{% endschema %}
