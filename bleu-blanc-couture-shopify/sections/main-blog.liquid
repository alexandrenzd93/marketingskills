<div class="page-header container">
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span class="sep">/</span><span>{{ blog.title }}</span>
  </nav>
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h1 class="page-title page-title--xl">{{ blog.title }}</h1>
  {%- if section.settings.intro != blank -%}<p class="page-intro">{{ section.settings.intro }}</p>{%- endif -%}
</div>

<section class="section" style="padding-top: clamp(20px,3vw,40px);">
  <div class="container">
    {%- paginate blog.articles by 13 -%}
      {%- assign start = 0 -%}
      {%- if paginate.current_page == 1 and blog.articles.size > 0 -%}
        {%- assign featured = blog.articles.first -%}
        {%- assign start = 1 -%}
        <article class="journal-featured reveal">
          <a class="journal-featured__media media tone-atelier" href="{{ featured.url }}" aria-label="Lire l'article">
            {%- render 'image-layers', image: featured.image, alt: featured.title, sizes: '(min-width:768px) 50vw, 100vw' -%}
          </a>
          <div>
            <span class="journal-featured__tag">À la une{% if featured.tags.size > 0 %} · {{ featured.tags.first }}{% endif %}</span>
            <h2 class="journal-featured__title">{{ featured.title }}</h2>
            <p class="journal-featured__excerpt">{{ featured.excerpt_or_content | strip_html | truncatewords: 40 }}</p>
            <div style="display:flex; align-items:center; gap:20px; flex-wrap:wrap;">
              <a class="link-arrow" href="{{ featured.url }}">Lire l'article <span class="arrow">&rarr;</span></a>
              <span class="journal-featured__meta">{{ featured.published_at | date: '%-d %B %Y' }}</span>
            </div>
          </div>
        </article>
      {%- endif -%}

      <div class="article-grid">
        {%- for article in blog.articles offset: start -%}
          <a class="article-card reveal" href="{{ article.url }}">
            <div class="media {% cycle 'tone-grege','tone-portrait','tone-stone','tone-sauge','tone-marron-glace','tone-bleu' %}">
              {%- render 'image-layers', image: article.image, alt: article.title, sizes: '(min-width:768px) 33vw, 100vw' -%}
            </div>
            {%- if article.tags.size > 0 -%}<span class="article-card__tag">{{ article.tags.first }}</span>{%- endif -%}
            <h3 class="article-card__title">{{ article.title }}</h3>
            <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            <div class="article-card__meta">
              <span class="article-card__date">{{ article.published_at | date: '%-d %B %Y' }}</span>
              <span class="link-arrow link-arrow--gold">Lire <span class="arrow">&rarr;</span></span>
            </div>
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}<div class="pagination">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Journal (blog)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Lectures de l'atelier" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Reportages, savoir-faire, conseils. Tout ce qui se passe derrière les pièces — et tout ce qu'il faut savoir pour consommer la mode autrement." }
  ]
}
{% endschema %}
