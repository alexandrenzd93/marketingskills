<div class="page-header container">
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span class="sep">/</span><span>{{ page.title }}</span>
  </nav>
  {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
  <h1 class="page-title page-title--xl">{{ page.title }}</h1>
</div>

<section class="section" style="padding-top: clamp(20px,3vw,40px);">
  <div class="container {% if section.settings.narrow %}container--narrow{% endif %}">
    <div class="prose"><div class="rte">{{ page.content }}</div></div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre" },
    { "type": "checkbox", "id": "narrow", "label": "Largeur réduite (texte)", "default": true }
  ]
}
{% endschema %}
