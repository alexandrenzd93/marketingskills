<section class="section {{ section.settings.background }}">
  <div class="container">
    <div class="section-head section-head--center reveal" style="margin-bottom: clamp(1.8rem,3vw,2.6rem);">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--center">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="section-title">{{ section.settings.title }}</h2>{%- endif -%}
    </div>
    <div class="collection-tags reveal" style="justify-content:center;{% if section.settings.show_products %} margin-bottom: clamp(2.4rem,4vw,3.4rem);{% endif %}">
      {%- for block in section.blocks -%}
        <a class="collection-tag" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_products -%}
      {%- assign coll = collections[section.settings.collection] -%}
      {%- if coll != blank and coll.products_count > 0 -%}
        <div class="product-grid">
          {%- for product in coll.products limit: section.settings.products_to_show -%}
            {%- render 'product-card', product: product, index: forloop.index0 -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.cta_label != blank -%}
          <div class="section-cta reveal"><a class="btn btn--ghost btn--lg" href="{{ coll.url }}">{{ section.settings.cta_label }}</a></div>
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections (grille)",
  "settings": [
    {
      "type": "select", "id": "background", "label": "Fond",
      "options": [
        { "value": "bg-creme", "label": "Crème" },
        { "value": "bg-creme-dark", "label": "Crème foncé" },
        { "value": "bg-creme-medium", "label": "Crème moyen" }
      ],
      "default": "bg-creme-dark"
    },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Ses Collections" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Sept territoires, un même geste" },
    { "type": "header", "content": "Grille de produits" },
    { "type": "checkbox", "id": "show_products", "label": "Afficher une grille de produits", "default": true },
    { "type": "collection", "id": "collection", "label": "Collection à afficher" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Nombre de produits", "default": 6 },
    { "type": "text", "id": "cta_label", "label": "Bouton (bas)", "default": "Voir toutes les pièces" }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Étiquette",
      "settings": [
        { "type": "text", "id": "label", "label": "Texte", "default": "Conception" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections (grille)",
      "blocks": [
        { "type": "tag", "settings": { "label": "Conception" } },
        { "type": "tag", "settings": { "label": "Illusion" } },
        { "type": "tag", "settings": { "label": "Certitude" } },
        { "type": "tag", "settings": { "label": "Sensation" } },
        { "type": "tag", "settings": { "label": "Sœur" } },
        { "type": "tag", "settings": { "label": "Palace" } },
        { "type": "tag", "settings": { "label": "Évasion" } }
      ]
    }
  ]
}
{% endschema %}
