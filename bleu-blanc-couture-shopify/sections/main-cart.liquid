<div class="page-header container">
  <nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ routes.root_url }}">Accueil</a><span class="sep">/</span><span>Panier</span>
  </nav>
  <p class="eyebrow">Votre sélection</p>
  <h1 class="page-title page-title--xl">Panier</h1>
</div>

<section class="section" style="padding-top: clamp(16px,2vw,28px);">
  <div class="container">
    {%- if cart.item_count == 0 -%}
      <div class="cart-empty">
        <h2 class="cart-empty__title">Votre panier est vide</h2>
        <p style="color:var(--gris);margin-bottom:1.8rem;">Découvrez nos pièces Made in France, façonnées par nos créatrices.</p>
        <a class="btn btn--gold btn--lg" href="{{ routes.all_products_collection_url }}">Voir le catalogue</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart" id="cart">
        <div class="cart-table">
          {%- for item in cart.items -%}
            <div class="cart-row">
              <a class="cart-row__media" href="{{ item.url }}">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.image.alt | escape }}" width="90" height="120" loading="lazy">{%- endif -%}
              </a>
              <div class="cart-row__info">
                {%- if item.product.vendor != blank -%}<p class="cart-row__brand">{{ item.product.vendor }}</p>{%- endif -%}
                <a class="cart-row__name" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-row__variant">{{ item.variant.title }}</p>{%- endunless -%}
                {%- if item.selling_plan_allocation -%}<p class="cart-row__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
                <a class="cart-row__remove" href="{{ item.url_to_remove }}">Retirer</a>
              </div>
              <div class="cart-row__qty">
                <div class="qty-stepper">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" aria-label="Diminuer">−</a>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantité" inputmode="numeric">
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" aria-label="Augmenter">+</a>
                </div>
              </div>
              <div class="cart-row__price">{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-foot">
          <div class="cart-foot__note">
            {{ section.settings.note | default: 'Livraison et taxes calculées au paiement. Livraison offerte dès 200 € en France.' }}
            <div style="margin-top:14px;">
              <button type="submit" name="update" class="btn btn--ghost">Mettre à jour le panier</button>
            </div>
          </div>
          <div class="cart-foot__totals">
            <p class="cart-foot__subtotal">{{ cart.total_price | money }}</p>
            <p class="cart-foot__tax">Taxes incluses · Livraison calculée au paiement</p>
            <button type="submit" name="checkout" class="btn btn--gold btn--lg btn--block">Passer la commande</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Panier",
  "settings": [
    { "type": "text", "id": "note", "label": "Note (sous le panier)", "default": "Livraison et taxes calculées au paiement. Livraison offerte dès 200 € en France." }
  ]
}
{% endschema %}
