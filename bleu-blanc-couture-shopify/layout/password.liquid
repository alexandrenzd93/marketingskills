<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="{{ settings.color_hero_dark }}">
  <title>{{ shop.name }}</title>
  {%- unless settings.logo_image -%}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231A1A1A'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='17' font-style='italic' fill='%23C9A96E' text-anchor='middle'%3EB%3C/text%3E%3C/svg%3E">
  {%- endunless -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400;1,6..96,500&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'bbc-shopify.css' | asset_url | stylesheet_tag }}
  {%- style -%}
    :root {
      --creme: {{ settings.color_creme }}; --gold: {{ settings.color_gold }};
      --gold-light: {{ settings.color_gold_light }}; --noir: {{ settings.color_noir }};
      --hero-dark: {{ settings.color_hero_dark }};
    }
    body.template-password { background: var(--hero-dark); color: var(--creme); }
  {%- endstyle -%}
  {{ content_for_header }}
</head>
<body class="template-password">
  {{ content_for_layout }}
</body>
</html>
