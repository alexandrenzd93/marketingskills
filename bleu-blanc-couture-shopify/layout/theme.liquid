<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="theme-color" content="{{ settings.color_creme }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- unless settings.logo_image -%}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231A1A1A'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='17' font-style='italic' fill='%23C9A96E' text-anchor='middle'%3EB%3C/text%3E%3C/svg%3E">
  {%- else -%}
    <link rel="icon" href="{{ settings.logo_image | image_url: width: 64 }}">
  {%- endunless -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} &mdash; {{ shop.name }}{% endunless %}</title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- comment -%} Fonts: Newsreader (display) + Raleway (body) {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'bbc-shopify.css' | asset_url | stylesheet_tag }}
  {{ 'bbc-custom.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    :root {
      --creme: {{ settings.color_creme }};
      --creme-dark: {{ settings.color_creme_dark }};
      --creme-medium: {{ settings.color_creme_medium }};
      --gold: {{ settings.color_gold }};
      --gold-light: {{ settings.color_gold_light }};
      --noir: {{ settings.color_noir }};
      --hero-dark: {{ settings.color_hero_dark }};
      --maxw: {{ settings.page_width | default: 1340 }}px;
    }
  {%- endstyle -%}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js'); if (window.Shopify && Shopify.designMode) { document.documentElement.classList.add('bbc-design-mode'); }</script>

  {{ content_for_header }}
</head>

{%- liquid
  assign body_class = 'template-' | append: request.page_type | handle
  if template.name == 'index'
    assign body_class = body_class | append: ' home'
  elsif template.suffix == 'histoire' or template.suffix == 'creator-detail'
    assign body_class = body_class | append: ' hero-page'
  endif
-%}
<body class="{{ body_class }}">

  <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  <div class="page-transition" aria-hidden="true"><span class="page-transition__mark">{{ settings.logo_text | default: shop.name }}</span></div>

  {% sections 'header-group' %}

  <main id="MainContent" class="site-main" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <script src="{{ 'global.js' | asset_url }}" defer></script>
  <script>document.addEventListener('shopify:section:load',function(e){var r=(e.target||document).querySelectorAll('.reveal');for(var i=0;i<r.length;i++){r[i].classList.add('is-visible');}});</script>
</body>
</html>
