{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'cart' %}
  Names: close, search, account, cart, location, lock, instagram, tiktok,
         facebook, pinterest, truck, return, shield, calendar, filter, pin,
         value-made, value-creators, value-shipping, arrow
{%- endcomment -%}
{%- liquid
  assign n = name | default: ''
-%}
{%- case n -%}
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
  {%- when 'account' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.5-6.5 8-6.5s8 2.5 8 6.5"/></svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
  {%- when 'location' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.3 7-11a7 7 0 0 0-14 0c0 4.7 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 3c.36 2.3 1.74 3.94 4 4.18v2.62c-1.42.06-2.8-.32-4-1.05v5.92c0 3.4-2.74 5.84-5.96 5.32-2.6-.42-4.4-2.72-4.06-5.34.3-2.36 2.36-4.16 4.86-3.98v2.74c-.42-.1-.9-.1-1.32.02-1 .28-1.6 1.18-1.42 2.18.18 1 1.16 1.72 2.18 1.52 1-.18 1.62-1 1.62-2.02V3h2.42z"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h3V5.5h-3c-2.2 0-3.6 1.5-3.6 3.7V11H8v3.5h2.4V22h3.5v-7.5h2.6l.5-3.5h-3.1V9.6c0-.4.2-.6.6-.6z"/></svg>
  {%- when 'pinterest' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.8 1.5 1.8 1.8 0 3-2.3 3-5 0-2.1-1.4-3.6-3.9-3.6a4.4 4.4 0 0 0-4.6 4.4c0 .9.3 1.5.7 2 .2.2.2.3.1.5l-.2.9c0 .3-.2.4-.5.2-1.3-.5-1.9-2-1.9-3.6 0-2.7 2.3-5.9 6.7-5.9 3.6 0 5.9 2.6 5.9 5.3 0 3.6-2 6.3-5 6.3-1 0-2-.5-2.3-1.2l-.6 2.5c-.2.8-.7 1.7-1.1 2.3A10 10 0 1 0 12 2z"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h13v10H3z"/><path d="M16 10h3l2 3v4h-5z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
  {%- when 'return' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><polyline points="3 4 3 8 7 8"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 9.5C8 19.2 5 15.5 5 11V6z"/></svg>
  {%- when 'calendar' -%}
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4.5" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2.5" x2="8" y2="6"/><line x1="16" y1="2.5" x2="16" y2="6"/></svg>
  {%- when 'filter' -%}
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/><circle cx="9" cy="7" r="2" fill="var(--creme)"/><circle cx="15" cy="12" r="2" fill="var(--creme)"/><circle cx="8" cy="17" r="2" fill="var(--creme)"/></svg>
  {%- when 'pin' -%}
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
  {%- when 'value-made' -%}
    <svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"><polygon points="28,5 48,16.5 48,39.5 28,51 8,39.5 8,16.5"/><path d="M28 35c-4-2.8-7-4.8-7-7.6a3.1 3.1 0 0 1 7-1 3.1 3.1 0 0 1 7 1c0 2.8-3 4.8-7 7.6z" stroke-linecap="round"/></svg>
  {%- when 'value-creators' -%}
    <svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><circle cx="28" cy="28" r="22"/><circle cx="28" cy="23" r="6"/><path d="M16.5 41.5c1.8-6 6-9 11.5-9s9.7 3 11.5 9"/></svg>
  {%- when 'value-shipping' -%}
    <svg viewBox="0 0 56 56" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M28 6l19 10v24L28 50 9 40V16z"/><path d="M9 16l19 10 19-10"/><path d="M28 26v24"/><path d="M18.5 11l19 10"/></svg>
  {%- when 'arrow' -%}
    <span class="arrow" aria-hidden="true">&rarr;</span>
{%- endcase -%}
