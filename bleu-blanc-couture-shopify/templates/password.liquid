{% layout 'password' %}
<section style="min-height:100vh; display:grid; place-items:center; text-align:center; padding:40px;">
  <div class="container container--narrow">
    <p style="font-family:var(--font-display); font-style:italic; font-size:clamp(34px,6vw,68px); color:var(--gold); line-height:1.05;">{{ shop.name }}</p>
    <p style="margin:1.6rem 0 2rem; color:var(--creme); opacity:.82; font-weight:300;">
      {{ shop.password_message | default: "Bientôt disponible. Une sélection intime de créatrices françaises." }}
    </p>

    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
        <input type="password" name="password" placeholder="Mot de passe" aria-label="Mot de passe"
          style="padding:13px 18px; border:1px solid var(--gold); background:transparent; color:var(--creme); border-radius:2px; min-width:220px;">
        <button class="btn btn--gold" type="submit">Entrer</button>
      </div>
    {%- endform -%}

    <p style="margin-top:2.4rem; font-size:12px; letter-spacing:.14em; text-transform:uppercase; opacity:.6;">
      Propriétaire de la boutique ? <a href="/admin" style="color:var(--gold);">Se connecter</a>
    </p>
  </div>
</section>
