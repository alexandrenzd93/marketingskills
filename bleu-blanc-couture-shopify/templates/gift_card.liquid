<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{{ 'gift_cards.issued.title' | t: value: gift_card.balance | money, shop: shop.name }} — {{ shop.name }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'bbc-shopify.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body style="background:var(--creme); display:grid; place-items:center; min-height:100vh; padding:40px;">
  <div class="container container--narrow" style="text-align:center; max-width:520px;">
    <p style="font-family:var(--font-display); font-style:italic; font-size:34px; color:var(--gold);">{{ shop.name }}</p>
    <p class="eyebrow eyebrow--center" style="margin:1.6rem 0 .6rem;">Carte cadeau</p>
    <h1 style="font-family:var(--font-display); font-size:clamp(40px,8vw,72px);">{{ gift_card.balance | money }}</h1>

    <div style="margin:2rem auto; padding:24px; border:1px solid var(--line); border-radius:var(--radius); background:var(--blanc);">
      <p style="font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--gris); margin-bottom:.8rem;">Votre code</p>
      <p style="font-size:22px; letter-spacing:.12em; font-weight:500;">{{ gift_card.code | format_code }}</p>
      {{ gift_card | img_tag: '', '', 320 }}
    </div>

    {%- if gift_card.enabled and gift_card.balance > 0 -%}
      <a class="btn btn--gold btn--lg" href="{{ shop.url }}">Utiliser ma carte</a>
    {%- endif -%}
    <p style="margin-top:1.4rem; font-size:13px; color:var(--gris);">{{ 'gift_cards.issued.how_to_use_gift_card' | t: shop_link: shop.url, balance: gift_card.balance | money }}</p>
  </div>
</body>
</html>
