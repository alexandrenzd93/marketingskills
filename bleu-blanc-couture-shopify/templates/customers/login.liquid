<div class="page-header container">
  <h1 class="page-title page-title--xl">Connexion</h1>
</div>
<section class="section" style="padding-top: clamp(20px,3vw,40px);">
  <div class="container container--narrow" style="max-width:460px;">

    <div id="recover" style="display:none;">
      <h2 class="section-title" style="font-size:24px;margin-bottom:1rem;">Réinitialiser le mot de passe</h2>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}<p class="form-msg">Nous vous avons envoyé un e-mail de réinitialisation.</p>{%- endif -%}
        <div class="field"><label for="RecoverEmail">Email</label><input type="email" id="RecoverEmail" name="email" required></div>
        <button class="btn btn--gold btn--block" type="submit">Envoyer</button>
        <p style="margin-top:1rem;"><a href="#" onclick="document.getElementById('recover').style.display='none';document.getElementById('login').style.display='block';return false;" style="color:var(--gold);">Retour à la connexion</a></p>
      {%- endform -%}
    </div>

    <div id="login">
      {%- form 'customer_login' -%}
        {{ form.errors | default_errors }}
        <div class="field"><label for="CustomerEmail">Email</label><input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required></div>
        <div class="field"><label for="CustomerPassword">Mot de passe</label><input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password"></div>
        <button class="btn btn--gold btn--block" type="submit">Se connecter</button>
      {%- endform -%}
      <p style="margin-top:1.2rem;text-align:center;color:var(--gris);">
        <a href="#" onclick="document.getElementById('login').style.display='none';document.getElementById('recover').style.display='block';return false;" style="color:var(--gold);">Mot de passe oublié ?</a>
        {%- if shop.customer_accounts_enabled -%} · <a href="{{ routes.account_register_url }}" style="color:var(--gold);">Créer un compte</a>{%- endif -%}
      </p>
    </div>

  </div>
</section>
