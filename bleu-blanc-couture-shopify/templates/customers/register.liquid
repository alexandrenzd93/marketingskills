<div class="page-header container">
  <h1 class="page-title page-title--xl">Créer un compte</h1>
</div>
<section class="section" style="padding-top: clamp(20px,3vw,40px);">
  <div class="container container--narrow" style="max-width:460px;">
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label for="FirstName">Prénom</label><input type="text" id="FirstName" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="LastName">Nom</label><input type="text" id="LastName" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="field"><label for="Email">Email</label><input type="email" id="Email" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="Password">Mot de passe</label><input type="password" id="Password" name="customer[password]" autocomplete="new-password"></div>
      <button class="btn btn--gold btn--block" type="submit">Créer mon compte</button>
    {%- endform -%}
    <p style="margin-top:1.2rem;text-align:center;color:var(--gris);">Déjà un compte ? <a href="{{ routes.account_login_url }}" style="color:var(--gold);">Se connecter</a></p>
  </div>
</section>
