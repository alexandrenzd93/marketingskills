<div class="page-header container">
  <h1 class="page-title page-title--xl">Nouveau mot de passe</h1>
</div>
<section class="section" style="padding-top: clamp(20px,3vw,40px);">
  <div class="container container--narrow" style="max-width:460px;">
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label for="ResetPassword">Mot de passe</label><input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password"></div>
      <div class="field"><label for="ResetPasswordConfirm">Confirmer le mot de passe</label><input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password"></div>
      <button class="btn btn--gold btn--block" type="submit">Réinitialiser</button>
    {%- endform -%}
  </div>
</section>
